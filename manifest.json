{
  "manifest_version": 3,
  "name": "CLASS Enter",
  "version": "1.3.0",
  "description": "東京理科大学 CLASS の入口を自動で進め、出席登録を Enter キーで操作します。",
  "permissions": ["storage"],
  "action": {
    "default_title": "CLASS Enter の設定",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://class.admin.tus.ac.jp/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
